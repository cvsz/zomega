OMEGA_ENV=production
OMEGA_HOST=0.0.0.0
OMEGA_PORT=8000
OMEGA_PUBLIC_URL=https://omega.example.com

DATABASE_URL=postgresql+psycopg://omega:CHANGE_ME@postgres:5432/omega
REDIS_URL=redis://redis:6379/0

OMEGA_API_KEY_PEPPER=CHANGE_ME_64_CHAR_RANDOM
OMEGA_ADMIN_TOKEN=CHANGE_ME_64_CHAR_RANDOM
OMEGA_DEFAULT_PLAN=pro
OMEGA_RATE_LIMIT_PER_MINUTE=60
OMEGA_MAX_RUN_CREDITS=5000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_STORE=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_1000=price_REPLACE_ME
STRIPE_PRICE_CREDITS_5000=price_REPLACE_ME
STRIPE_PRICE_CREDITS_20000=price_REPLACE_ME

OMEGA_LOG_LEVEL=INFO
