ZOMEGA_ENV=production
ZOMEGA_HOST=0.0.0.0
ZOMEGA_PORT=8000
ZOMEGA_PUBLIC_URL=https://zomega.example.com

POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES
DATABASE_URL=postgresql+psycopg://zomega:CHANGE_ME_STRONG_POSTGRES@postgres:5432/zomega

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS@redis:6379/0

ZOMEGA_API_KEY_PEPPER=CHANGE_ME_64_CHAR_RANDOM
ZOMEGA_ADMIN_TOKEN=CHANGE_ME_64_CHAR_RANDOM
ZOMEGA_DEFAULT_PLAN=pro
ZOMEGA_RATE_LIMIT_PER_MINUTE=60
ZOMEGA_MAX_RUN_CREDITS=5000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_STORE=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_1000=price_REPLACE_ME
STRIPE_PRICE_CREDITS_5000=price_REPLACE_ME
STRIPE_PRICE_CREDITS_20000=price_REPLACE_ME

ZOMEGA_LOG_LEVEL=INFO
